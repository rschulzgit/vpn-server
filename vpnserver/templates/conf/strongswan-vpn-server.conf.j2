# Verwaltet von VPN-Server
charon {
    # Mehrere Clients hinter derselben NAT und Windows-Clients unterstuetzen
    ikesa_table_size = 32
    ikesa_table_segments = 4
    # Grosse IKE-Nachrichten (Zertifikate) fragmentieren
    fragment_size = 1280
    # Cisco-Unity-Erweiterungen fuer iOS/macOS "Cisco IPsec"
    cisco_unity = yes
    plugins {
        eap-mschapv2 {
            load = yes
        }
        xauth-generic {
            load = yes
        }
{% if radius %}
        # Anmeldung ueber den lokalen RADIUS-Dienst; die Gruppe (Class-Attribut)
        # bestimmt den Adressbereich bzw. das VLAN
        eap-radius {
            load = yes
            accounting = yes
            accounting_close_on_timeout = no
            class_group = yes
            nas_identifier = vpn-ipsec
            servers {
                local {
                    address = 127.0.0.1
                    secret = {{ secret }}
                    auth_port = 1812
                    acct_port = 1813
                }
            }
        }
{% endif %}
    }
}
