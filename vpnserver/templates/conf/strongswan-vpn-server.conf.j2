# Verwaltet von VPN-Server
charon {
    # Mehrere Clients hinter derselben NAT und Windows-Clients unterstuetzen
    ikesa_table_size = 32
    ikesa_table_segments = 4
    # Grosse IKE-Nachrichten (Zertifikate) fragmentieren
    fragment_size = 1280
    # Cisco-Unity-Erweiterungen fuer iOS/macOS "Cisco IPsec"
    cisco_unity = yes
    plugins {
        eap-mschapv2 {
            load = yes
        }
        xauth-generic {
            load = yes
        }
    }
}
