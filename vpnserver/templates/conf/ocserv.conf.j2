# Verwaltet von VPN-Server - manuelle Aenderungen werden ueberschrieben.
auth = "plain[passwd=/etc/vpn-server/ocpasswd]"
tcp-port = {{ port }}
udp-port = {{ port }}
run-as-user = nobody
run-as-group = daemon
socket-file = /run/ocserv-socket
server-cert = {{ tls_cert }}
server-key = {{ tls_key }}
isolate-workers = true
max-clients = 256
max-same-clients = 4
rate-limit-ms = 100
server-stats-reset-time = 604800
keepalive = 32400
dpd = 90
mobile-dpd = 1800
switch-to-tcp-timeout = 25
try-mtu-discovery = true
tls-priorities = "NORMAL:%SERVER_PRECEDENCE:%COMPAT:-VERS-SSL3.0:-VERS-TLS1.0:-VERS-TLS1.1:-RSA:-VERS-DTLS1.0:-ARCFOUR-128"
auth-timeout = 240
min-reauth-time = 300
max-ban-score = 80
ban-reset-time = 1200
cookie-timeout = 300
deny-roaming = false
rekey-time = 172800
rekey-method = ssl
use-occtl = true
pid-file = /run/ocserv.pid
log-level = 1
device = vpns
predictable-ips = true
default-domain = vpn
ipv4-network = {{ network }}
ipv4-netmask = {{ netmask }}
tunnel-all-dns = true
{% for d in dns %}
dns = {{ d }}
{% endfor %}
ping-leases = false
route = default
cisco-client-compat = true
dtls-legacy = true
